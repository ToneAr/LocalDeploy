\>", "TableText",ExpressionUUID->"98f98cfe-3a57-4569-bbe0-659d37c8c87c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c2797124-65e4-4998-add2-ea559a341865"], "\"\<HostAddress\>\"", \
"\"\<localhost\>\"", Cell[
