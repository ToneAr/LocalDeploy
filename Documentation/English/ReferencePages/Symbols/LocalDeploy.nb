Cell[TextData[{
 "LocalDeploy will deploy a parallel evaluation queue tasks which will run ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Parallel`Developer`QueueRun",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Parallel`Developer`QueueRun"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"4d0b4f20-b5ee-4618-8948-66bd051f87c4"],
 " every 50 milliseconds (adjustable). This will change the behaviour of ",
 Cell[BoxData[
  ButtonBox["EvaluationObjects",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/EvaluationObject"]], "InlineFormula",
  ExpressionUUID->"24130fd6-fbc5-4576-a8a0-10ec2393e92c"],
 " in the session."
}], "Notes",
