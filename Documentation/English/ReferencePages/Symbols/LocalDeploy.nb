Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispatch", " ", "=", " ", 
   RowBox[{"URLDispatcher", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\"\</data/static\>\"", " ", "->", "Now"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\</data/delayed\>\"", " ", ":>", " ", "Now"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\</api\>\"", " ", "->", " ", 
       RowBox[{"APIFunction", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{"\"\<x\>\"", " ", "->", " ", "\"\<Number\>\""}], 
          "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#x", "^", "3"}], "&"}], ")"}]}], "\[IndentingNewLine]", 
        "]"}]}]}], "\[IndentingNewLine]", "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"dep", " ", "=", " ", 
  RowBox[{"LocalDeploy", "[", 
   RowBox[{"dispatch", ",", " ", "8080"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9576050827601*^9, 3.9576052328392677`*^9}, 
