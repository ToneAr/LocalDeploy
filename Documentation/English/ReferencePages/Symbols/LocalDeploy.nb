    ButtonBox["OverwriteTarget",
     BaseStyle->"Link"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell["\<\
OverwriteTarget is an option for functions like CopyFile that specifies \
whether to overwrite if target files already exist.\
\>", "TableText",ExpressionUUID->"cb77894f-64a4-4312-9396-1e356fbb2f1a"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b752d0f0-0736-44bb-ae62-d6ce7d69a231"], "\"\<EvaluationInterval\>\"", 
    RowBox[{"Quantity", "[", 
     RowBox[{"50", ",", " ", "\"\<Milliseconds\>\""}], "]"}], Cell["\<\
